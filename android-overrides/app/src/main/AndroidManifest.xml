<?xml version="1.0" encoding="utf-8"?>
<!--
  GeniusFiles AndroidManifest (authoritative override).

  This file is copied verbatim over the manifest generated by
  `npx cap add android`, so it MUST be a complete, self-contained manifest
  — including the LAUNCHER activity — otherwise the installed APK has no
  launcher icon and Android falls back to displaying the package name.

  Permissions cover:
    - MANAGE_EXTERNAL_STORAGE : full file-manager (Android 11+).
    - READ_MEDIA_* : granular media access (Android 13+).
    - READ/WRITE_EXTERNAL_STORAGE : legacy storage compat (Android ≤ 10).
    - FOREGROUND_SERVICE / POST_NOTIFICATIONS : long-running copy/move ops.
    - INTERNET / ACCESS_*_STATE / CHANGE_*_STATE / NEARBY_WIFI_DEVICES /
      ACCESS_FINE_LOCATION : offline P2P transfer plugin.
    - CAMERA : QR pairing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      App Manager (Gestionnaire d'applications):
        - QUERY_ALL_PACKAGES : list every installed package on Android 11+.
        - PACKAGE_USAGE_STATS : real per-app storage stats + last used time.
          Special access — the user must toggle it in Settings ▸ Access to
          usage data; the plugin's requestUsageAccess() opens that page.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Ouverture d'un .apk depuis le gestionnaire : Android exige cette
         autorisation pour que l'application puisse demander l'installation
         d'un paquet (l'utilisateur reste maître via « sources inconnues »). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Automations: fire notifications at exact times even when the app
         is closed, and rearm alarms after a device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />


    <!-- Offline P2P transfer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- WAKE_LOCK déjà déclaré plus haut (opérations longues). -->


    <!-- QR pairing -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Coffre-fort : déverrouillage biométrique (empreinte / visage).
         USE_BIOMETRIC couvre Android 9+, USE_FINGERPRINT reste requis
         pour les appareils Android 8 et antérieurs. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <application
        android:name="app.geniusfiles.mobile.GeniusFilesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true">

        <activity
            android:name="app.geniusfiles.mobile.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>



        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Foreground service backing every active P2P transfer. Runs the
          persistent notification so Android does not evict the process
          while the TCP transfer is streaming in the background.
        -->
        <service
            android:name="app.geniusfiles.mobile.TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Foreground service backing the audio player. Holds the media
          notification and keeps the WebView audio pipeline alive while the
          user backgrounds the app or locks the screen.
        -->
        <service
            android:name="app.geniusfiles.mobile.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Handles Pause / Resume / Cancel intents fired from the
          notification's action buttons.
        -->
        <receiver
            android:name="app.geniusfiles.mobile.TransferActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.geniusfiles.mobile.TRANSFER_PAUSE" />
                <action android:name="app.geniusfiles.mobile.TRANSFER_RESUME" />
                <action android:name="app.geniusfiles.mobile.TRANSFER_CANCEL" />
            </intent-filter>
        </receiver>

        <!--
          Moteur natif de copie / déplacement. `stopWithTask="false"` :
          la tâche continue même si l'utilisateur ferme l'application
          depuis les applications récentes.
        -->
        <service
            android:name="app.geniusfiles.mobile.FileOpsService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- Actions « Annuler » / « Ouvrir le dossier » des transferts. -->
        <receiver
            android:name="app.geniusfiles.mobile.FileOpsActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.geniusfiles.mobile.FILEOPS_CANCEL" />
                <action android:name="app.geniusfiles.mobile.FILEOPS_OPEN_DEST" />
            </intent-filter>
        </receiver>

        <!-- Fires automation notifications independently of the WebView. -->
        <receiver
            android:name="app.geniusfiles.mobile.AutomationAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.geniusfiles.mobile.AUTOMATION_FIRE" />
            </intent-filter>
        </receiver>

        <!-- Re-arms persisted automation alarms after reboot / update. -->
        <receiver
            android:name="app.geniusfiles.mobile.AutomationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
