<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive splash icon used by @style/AppTheme.NoActionBarLaunch on
  API 31+. Android masks ~1/3 of the foreground layer, leaving the
  inner ~66% visible; splash_icon_foreground.png is authored so the
  logo already sits at that 66% inner ratio, so the mark fills the
  visible circle at native resolution.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/splash_icon_foreground" />
</adaptive-icon>
